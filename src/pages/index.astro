        border-radius: 18px;
        margin: 4rem 0 5rem 0;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      }

      .cta-banner h2 {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #FFFFFF;
        margin: 0 0 1rem 0;
      }

      .cta-banner p {
        color: #CBD5E1;
        font-size: 1.15rem;
        max-width: 650px;
        margin: 0 auto 2.25rem auto;
        line-height: 1.6;
      }

      /* --- Footer --- */
      footer {
        border-top: 1px solid var(--rc-border);
        padding: 4.5rem 0 2.5rem 0;
        background: #05080E;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.2fr;
        gap: 3rem;
        margin-bottom: 3.5rem;
      }

      .footer-brand p {
        color: var(--rc-text-muted);
        font-size: 0.92rem;
        line-height: 1.65;
        max-width: 360px;
        margin-top: 0.75rem;
      }

      .footer-col h4 {
        color: #FFFFFF;
        margin: 0 0 1.25rem 0;
        font-size: 0.92rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
      }

      .footer-col a {
        color: var(--rc-text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.15s ease;
      }

      .footer-col a:hover {
        color: var(--rc-mint);
      }

      .footer-bottom {
        border-top: 1px solid var(--rc-border);
        padding-top: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--rc-text-muted);
        font-size: 0.85rem;
        flex-wrap: wrap;
        gap: 1rem;
      }

      /* --- Responsive Breakpoints --- */
      @media (max-width: 1024px) {
        .bento-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .pipeline-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .footer-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 768px) {
        .hero-h1 {
          font-size: 2.5rem;
        }
