      /* --- CTA Pre-Footer Banner --- */
      .cta-banner {
        text-align: center;
        padding: 4.5rem 2rem;
        background: radial-gradient(circle at 50% 50%, rgba(16, 185, 129, 0.16) 0%, rgba(13, 19, 31, 0.9) 70%);
