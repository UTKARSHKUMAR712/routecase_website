    <style>
      /* --- Scoped Modern Design Tokens & Layout --- */
      :root {
        --rc-bg: #070A0F;
        --rc-bg-alt: #0D131F;
        --rc-card: #111724;
        --rc-card-hover: #162032;
        --rc-border: rgba(255, 255, 255, 0.08);
        --rc-border-bright: rgba(16, 185, 129, 0.35);
        --rc-text: #F8FAFC;
        --rc-text-muted: #94A3B8;
        --rc-emerald: #10B981;
        --rc-emerald-dark: #059669;
        --rc-mint: #34D399;
        --rc-amber: #F59E0B;
        --rc-font-mono: ui-monospace, 'JetBrains Mono', 'Fira Code', Menlo, Monaco, Consolas, monospace;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background-color: var(--rc-bg);
        color: var(--rc-text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      /* Dot grid background texture */
      .bg-grid-pattern {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1400px;
        background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
        background-size: 28px 28px;
        mask-image: linear-gradient(180deg, #000 65%, transparent 100%);
        pointer-events: none;
        z-index: 0;
      }

      /* Radial light spotlights */
      .spotlight-top {
        position: absolute;
        top: -120px;
        left: 50%;
        transform: translateX(-50%);
        width: 800px;
        height: 600px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, rgba(16, 185, 129, 0.03) 45%, transparent 70%);
        pointer-events: none;
        z-index: 0;
      }

      .spotlight-middle {
        position: absolute;
        top: 1300px;
        left: 50%;
        transform: translateX(-50%);
        width: 1000px;
        height: 700px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.08) 0%, transparent 65%);
        pointer-events: none;
        z-index: 0;
      }

      .container {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.5rem;
        position: relative;
        z-index: 1;
      }

      /* --- Navigation Bar --- */
      header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(7, 10, 15, 0.82);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--rc-border);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 68px;
      }

      .logo-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #fff;
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.02em;
      }

      .logo-icon-wrap {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid rgba(16, 185, 129, 0.35);
        box-shadow: 0 0 16px rgba(16, 185, 129, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0E1624;
      }

      .logo-icon-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .logo-version-tag {
        font-family: var(--rc-font-mono);
        font-size: 0.72rem;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 9999px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: var(--rc-mint);
        margin-left: 4px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.75rem;
      }

      .nav-link {
        color: var(--rc-text-muted);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 500;
        transition: color 0.18s ease;
      }

      .nav-link:hover {
        color: #FFFFFF;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .btn-install-nav {
        background: linear-gradient(135deg, #10B981 0%, #059669 100%);
        color: #FFFFFF;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.88rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .btn-install-nav:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
      }

      .mobile-menu-btn {
        display: none;
        background: transparent;
        border: 1px solid var(--rc-border);
        border-radius: 8px;
        padding: 8px;
        color: var(--rc-text-muted);
        cursor: pointer;
      }

      /* Mobile Drawer */
      .mobile-drawer {
        display: none;
        padding: 1.5rem;
        background: #0B0F17;
        border-bottom: 1px solid var(--rc-border);
        flex-direction: column;
        gap: 1.25rem;
      }

      .mobile-drawer.open {
        display: flex;
      }

      /* --- Hero Section --- */
      .hero-wrap {
        padding: 5.5rem 0 3.5rem 0;
        text-align: center;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px 18px;
        border-radius: 9999px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(52, 211, 153, 0.35);
        color: var(--rc-mint);
        font-size: 0.84rem;
        font-weight: 600;
        margin-bottom: 2rem;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);
      }

      .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10B981;
        box-shadow: 0 0 8px #10B981;
        display: inline-block;
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.85); }
      }

      .hero-h1 {
        font-size: 3.75rem;
        font-weight: 800;
        line-height: 1.12;
        letter-spacing: -0.035em;
        margin: 0 auto 1.5rem auto;
        max-width: 960px;
        color: #FFFFFF;
      }

      .hero-gradient-text {
        background: linear-gradient(135deg, #FFFFFF 30%, #34D399 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-p {
        font-size: 1.22rem;
        color: var(--rc-text-muted);
        max-width: 780px;
        margin: 0 auto 2.5rem auto;
        line-height: 1.65;
      }

      .hero-p strong {
        color: #E2E8F0;
      }

      .hero-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2.25rem;
        flex-wrap: wrap;
      }

      .btn-cta-primary {
        background: linear-gradient(135deg, #10B981 0%, #059669 100%);
        color: #FFFFFF;
        padding: 13px 28px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 4px 25px rgba(16, 185, 129, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.25);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .btn-cta-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(16, 185, 129, 0.55);
      }

      .btn-cta-secondary {
        background: rgba(30, 41, 59, 0.55);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: #F8FAFC;
        padding: 13px 26px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--rc-border);
        transition: all 0.2s ease;
      }

      .btn-cta-secondary:hover {
        background: rgba(51, 65, 85, 0.8);
        border-color: rgba(52, 211, 153, 0.4);
        transform: translateY(-1px);
      }

      /* Command Line Copy Box */
      .cli-box {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        background: #0B1019;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 9px 16px;
        font-family: var(--rc-font-mono);
        font-size: 0.88rem;
        color: #CBD5E1;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        margin-bottom: 2.5rem;
        max-width: 520px;
        width: 100%;
      }

      .cli-prompt {
        color: var(--rc-mint);
        user-select: none;
      }

      .cli-code {
        color: #E2E8F0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .btn-cli-copy {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        padding: 5px 10px;
        color: var(--rc-mint);
        cursor: pointer;
        font-size: 0.78rem;
        font-family: var(--rc-font-mono);
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.15s ease;
        flex-shrink: 0;
      }

      .btn-cli-copy:hover {
        background: rgba(16, 185, 129, 0.2);
        border-color: rgba(52, 211, 153, 0.4);
      }

      /* Feature Trust Pills Row */
      .trust-pills {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 3.5rem;
      }

      .trust-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--rc-border);
        color: var(--rc-text-muted);
        font-size: 0.82rem;
        font-weight: 500;
      }

      .trust-pill svg {
        color: var(--rc-mint);
      }

      /* --- Realistic VS Code Mockup Window --- */
      .editor-frame {
        background: #0C111C;
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65), 0 0 35px rgba(16, 185, 129, 0.12);
        margin: 0 auto;
        text-align: left;
        font-family: var(--rc-font-mono);
        font-size: 0.88rem;
      }

      .editor-titlebar {
        background: #111827;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .editor-dots {
        display: flex;
        gap: 7px;
      }

      .editor-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        display: inline-block;
      }

      .dot-red { background: #EF4444; }
      .dot-yellow { background: #F59E0B; }
      .dot-green { background: #10B981; }

      .editor-window-title {
        color: #94A3B8;
        font-size: 0.8rem;
        margin: 0 auto;
        font-weight: 500;
      }

      .editor-tabs {
        background: #0A0E17;
        display: flex;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        overflow-x: auto;
      }

      .editor-tab {
        padding: 8px 18px;
        font-size: 0.8rem;
        color: #64748B;
        border-right: 1px solid rgba(255, 255, 255, 0.06);
        display: flex;
        align-items: center;
        gap: 8px;
        user-select: none;
      }

      .editor-tab.active {
        background: #0C111C;
        color: #F8FAFC;
        border-top: 2px solid var(--rc-emerald);
      }

      .editor-breadcrumbs {
        padding: 6px 16px;
        background: rgba(255, 255, 255, 0.015);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        color: #64748B;
        font-size: 0.76rem;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .editor-content-grid {
        display: grid;
        grid-template-columns: 50px 1fr;
        padding: 1.25rem 0;
      }

      .editor-gutter {
        color: #475569;
        text-align: right;
        padding-right: 14px;
        user-select: none;
        font-size: 0.82rem;
        line-height: 1.68;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
      }

      .editor-code-body {
        padding-left: 16px;
        padding-right: 16px;
        line-height: 1.68;
        overflow-x: auto;
      }

      /* CodeLens Floating Rows */
      .codelens-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 6px;
        font-size: 0.78rem;
      }

      .codelens-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.35);
        color: var(--rc-mint);
        padding: 2px 10px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.15s ease;
      }

      .codelens-btn:hover {
        background: rgba(16, 185, 129, 0.25);
        border-color: rgba(52, 211, 153, 0.6);
      }

      .pill-pass {
        background: rgba(16, 185, 129, 0.18);
        border: 1px solid rgba(16, 185, 129, 0.45);
        color: #34D399;
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 600;
      }

      .pill-capture {
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.35);
        color: #FBBF24;
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 500;
      }

      .editor-statusbar {
        background: #090D15;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 6px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.74rem;
        color: #94A3B8;
      }

      .statusbar-left, .statusbar-right {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .statusbar-badge-ok {
        color: var(--rc-mint);
        display: flex;
        align-items: center;
        gap: 5px;
        font-weight: 600;
      }

      /* Syntax highlighting tokens */
      .syn-k { color: #34D399; }
      .syn-s { color: #A7F3D0; }
      .syn-m { color: #F59E0B; font-weight: 600; }
      .syn-v { color: #FCD34D; }
      .syn-n { color: #6EE7B7; }

      /* --- Section Headers --- */
      .section-heading-wrap {
        text-align: center;
        margin: 6.5rem 0 3rem 0;
      }

      .section-tag {
        font-family: var(--rc-font-mono);
        font-size: 0.8rem;
        color: var(--rc-emerald);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }

      .section-title {
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #FFFFFF;
        margin: 0 0 1rem 0;
      }

      .section-desc {
        color: var(--rc-text-muted);
        font-size: 1.1rem;
        max-width: 680px;
        margin: 0 auto;
        line-height: 1.6;
      }

      /* --- Bento Grid Core Capabilities --- */
      .bento-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .bento-card {
        background: var(--rc-card);
        border: 1px solid var(--rc-border);
        border-radius: 14px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
      }

      .bento-card:hover {
        background: var(--rc-card-hover);
        border-color: rgba(16, 185, 129, 0.4);
        transform: translateY(-4px);
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.4), 0 0 25px rgba(16, 185, 129, 0.1);
      }

      .bento-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: var(--rc-mint);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
      }

      .bento-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #FFFFFF;
        margin: 0 0 0.75rem 0;
        letter-spacing: -0.01em;
      }

      .bento-desc {
        color: var(--rc-text-muted);
        font-size: 0.94rem;
        line-height: 1.6;
        margin: 0 0 1.5rem 0;
        flex-grow: 1;
      }

      .bento-preview-tag {
        font-family: var(--rc-font-mono);
        font-size: 0.78rem;
        background: #090E17;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 8px 12px;
        color: var(--rc-mint);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      /* --- Interactive Real-World Code Showcase Tabs --- */
      .showcase-wrapper {
        background: #0C111C;
        border: 1px solid var(--rc-border);
        border-radius: 14px;
        overflow: hidden;
        margin-top: 2rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      }

      .showcase-tabs-nav {
        display: flex;
        background: #090D15;
        border-bottom: 1px solid var(--rc-border);
        overflow-x: auto;
      }

      .showcase-tab-btn {
        padding: 14px 22px;
        background: transparent;
        border: none;
        color: #64748B;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
        white-space: nowrap;
      }

      .showcase-tab-btn:hover {
        color: #CBD5E1;
      }

      .showcase-tab-btn.active {
        color: #FFFFFF;
        border-bottom-color: var(--rc-emerald);
        background: rgba(16, 185, 129, 0.05);
      }

      .showcase-panel {
        display: none;
        padding: 1.75rem;
      }

      .showcase-panel.active {
        display: block;
      }

      .showcase-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .showcase-panel-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #FFFFFF;
        margin: 0;
      }

      .showcase-code {
        margin: 0;
        padding: 1.25rem;
        background: #070A0F;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        font-family: var(--rc-font-mono);
        font-size: 0.86rem;
        color: #E2E8F0;
        overflow-x: auto;
        line-height: 1.6;
      }

      /* --- 4-Step Engineering Pipeline --- */
      .pipeline-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
        margin-top: 2rem;
      }

      .pipeline-card {
        background: var(--rc-card);
        border: 1px solid var(--rc-border);
        border-radius: 14px;
        padding: 1.75rem 1.4rem;
        display: flex;
        flex-direction: column;
        transition: all 0.25s ease;
      }

      .pipeline-card:hover {
        border-color: var(--rc-emerald);
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.12);
      }

      .pipeline-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
      }

      .pipeline-step-badge {
        font-family: var(--rc-font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--rc-mint);
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        padding: 3px 10px;
        border-radius: 9999px;
      }

      .pipeline-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(16, 185, 129, 0.1);
        color: var(--rc-mint);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .pipeline-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #FFFFFF;
        margin: 0 0 0.5rem 0;
      }

      .pipeline-desc {
        color: var(--rc-text-muted);
        font-size: 0.88rem;
        line-height: 1.55;
        margin: 0 0 1.25rem 0;
        flex-grow: 1;
      }

      .pipeline-code-pill {
        background: #070A0F;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        padding: 8px 12px;
        font-family: var(--rc-font-mono);
        font-size: 0.78rem;
        color: #E2E8F0;
      }

      /* --- Comparison Matrix --- */
      .matrix-table-wrap {
        overflow-x: auto;
        border-radius: 14px;
        border: 1px solid var(--rc-border);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4);
        margin-top: 2rem;
      }

      .matrix-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
      }

      .matrix-table th {
        background: #0E1420;
        color: #FFFFFF;
        padding: 16px 20px;
        font-weight: 700;
        text-align: left;
        border-bottom: 2px solid var(--rc-border);
      }

      .matrix-table th.col-rc {
        background: rgba(16, 185, 129, 0.12);
        color: var(--rc-mint);
        border-left: 1px solid rgba(16, 185, 129, 0.35);
        border-right: 1px solid rgba(16, 185, 129, 0.35);
      }

      .matrix-table td {
        padding: 14px 20px;
        border-bottom: 1px solid var(--rc-border);
        color: #CBD5E1;
      }

      .matrix-table td.col-rc {
        background: rgba(16, 185, 129, 0.04);
        border-left: 1px solid rgba(16, 185, 129, 0.25);
        border-right: 1px solid rgba(16, 185, 129, 0.25);
        font-weight: 600;
        color: #FFFFFF;
      }

      .matrix-table tr:hover td {
        background: rgba(255, 255, 255, 0.02);
      }

      .matrix-table tr:hover td.col-rc {
        background: rgba(16, 185, 129, 0.08);
      }

      .matrix-pill-tag {
        font-family: var(--rc-font-mono);
        font-size: 0.76rem;
        padding: 2px 6px;
        border-radius: 4px;
        background: rgba(16, 185, 129, 0.15);
        color: var(--rc-mint);
        border: 1px solid rgba(16, 185, 129, 0.3);
        margin-left: 6px;
      }

      /* --- FAQ Accordion --- */
      .faq-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 900px;
        margin: 2rem auto 0 auto;
      }

      .faq-card {
        background: var(--rc-card);
        border: 1px solid var(--rc-border);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.2s ease;
      }

      .faq-card:hover {
        border-color: rgba(16, 185, 129, 0.4);
      }

      .faq-card[open] {
        border-color: var(--rc-emerald);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.1);
      }

      .faq-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        cursor: pointer;
        user-select: none;
        list-style: none;
      }

      .faq-header::-webkit-details-marker {
        display: none;
      }

      .faq-q-text {
        font-size: 1.05rem;
        font-weight: 600;
        color: #FFFFFF;
        flex-grow: 1;
      }

      .faq-tag {
        font-family: var(--rc-font-mono);
        font-size: 0.74rem;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 4px;
        background: rgba(16, 185, 129, 0.12);
        color: var(--rc-mint);
        border: 1px solid rgba(16, 185, 129, 0.25);
        white-space: nowrap;
      }

      .faq-arrow {
        color: #94A3B8;
        transition: transform 0.25s ease, color 0.2s ease;
      }

      .faq-card[open] .faq-arrow {
        transform: rotate(180deg);
        color: var(--rc-mint);
      }

      .faq-body {
        padding: 0 1.5rem 1.4rem 1.5rem;
        color: var(--rc-text-muted);
        font-size: 0.95rem;
        line-height: 1.68;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 1.1rem;
      }

      .faq-body code {
        font-family: var(--rc-font-mono);
        background: rgba(16, 185, 129, 0.12);
        color: var(--rc-mint);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.88em;
      }

      /* --- Creator & Author Spotlight --- */
      .author-spotlight {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(13, 19, 31, 0.95) 100%);
