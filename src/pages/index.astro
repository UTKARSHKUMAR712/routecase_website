    <!-- Interactive Client Scripts -->
    <script>
      // 1. Interactive Copy-to-Clipboard for CLI Install Command
      const cliCopyBtn = document.getElementById('cliCopyBtn');
      const cliCopyText = document.getElementById('cliCopyText');
      const cliCommand = document.getElementById('cliCommand');

      if (cliCopyBtn && cliCommand && cliCopyText) {
        cliCopyBtn.addEventListener('click', () => {
          const textToCopy = cliCommand.textContent || '';
          navigator.clipboard.writeText(textToCopy).then(() => {
            cliCopyText.textContent = 'Copied! ✓';
            cliCopyBtn.style.background = 'rgba(16, 185, 129, 0.3)';
            cliCopyBtn.style.borderColor = 'rgba(52, 211, 153, 0.7)';
            setTimeout(() => {
              cliCopyText.textContent = 'Copy';
              cliCopyBtn.style.background = '';
              cliCopyBtn.style.borderColor = '';
            }, 2000);
          }).catch(err => {
            console.error('Failed to copy: ', err);
          });
        });
      }

      // 2. Interactive Real-World Code Showcase Tabs
      const tabBtns = document.querySelectorAll('.showcase-tab-btn');
      const tabPanels = document.querySelectorAll('.showcase-panel');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          if (!targetId) return;

          tabBtns.forEach(b => b.classList.remove('active'));
          tabPanels.forEach(p => p.classList.remove('active'));

          btn.classList.add('active');
          const activePanel = document.getElementById(targetId);
          if (activePanel) {
            activePanel.classList.add('active');
          }
        });
      });

      // 3. Mobile Navigation Drawer Toggle
      const mobileMenuToggle = document.getElementById('mobileMenuToggle');
      const mobileDrawer = document.getElementById('mobileDrawer');

      if (mobileMenuToggle && mobileDrawer) {
        mobileMenuToggle.addEventListener('click', () => {
          mobileDrawer.classList.toggle('open');
        });
      }
    </script>
